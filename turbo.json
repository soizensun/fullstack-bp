{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "**/.env.*local"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "API_BASE_URL",
        "NODE_ENV",
        "PORT",
        "TODO_DATA_DIR",
        "TODO_DEFAULT_PAGE_SIZE",
        "TODO_MAX_PAGE_SIZE"
      ]
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "dist/**"
      ],
      "env": [
        "API_BASE_URL",
        "NODE_ENV",
        "PORT",
        "TODO_DATA_DIR",
        "TODO_DEFAULT_PAGE_SIZE",
        "TODO_MAX_PAGE_SIZE"
      ]
    },
    "contract:generate": {
      "cache": false
    },
    "lint": {},
    "test": {
      "env": [
        "API_BASE_URL",
        "NODE_ENV",
        "PORT",
        "TODO_DATA_DIR",
        "TODO_DEFAULT_PAGE_SIZE",
        "TODO_MAX_PAGE_SIZE"
      ]
    },
    "test:e2e": {
      "env": [
        "TODO_DATA_DIR",
        "TODO_DEFAULT_PAGE_SIZE",
        "TODO_MAX_PAGE_SIZE",
        "NODE_ENV",
        "PORT"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^build"
      ]
    },
    "test:integration": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "TODO_DATA_DIR",
        "TODO_DEFAULT_PAGE_SIZE",
        "TODO_MAX_PAGE_SIZE",
        "NODE_ENV",
        "PORT"
      ]
    },
    "test:bdd": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "TODO_DATA_DIR",
        "TODO_DEFAULT_PAGE_SIZE",
        "TODO_MAX_PAGE_SIZE",
        "NODE_ENV",
        "PORT"
      ]
    },
    "check-arch": {}
  }
}
